            "uid": "prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "expr": "sort(endoflife_product_info{product_name=~\"$product\"} * on (product_name, release_cycle_name) group_left () ((endoflife_eol_from_timestamp_seconds{product_name=~\"$product\"} - time()) / 86400))"
        }
      ],
      "title": "Release cycles",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "releases": true
            },
            "includeByName": {},
            "indexByName": {
              "product_name": 0,
              "release_cycle_name": 1,
              "latest_version": 2,
              "is_eol": 3,
              "is_lts": 4,
              "is_maintained": 5,
              "Value": 6
            },
            "renameByName": {
              "product_name": "Product",
              "release_cycle_name": "Cycle",
              "latest_version": "Latest version",
              "is_eol": "EOL?",
              "is_lts": "LTS",
              "is_maintained": "Maintained",
              "Value": "Days until EOL"
            }
          }
        }
      ],
      "type": "table"
    },
